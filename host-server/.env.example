# ─────────────────────────────────────────────────────────────────────────────
# RSW Field App — Host Sync Server Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Host's LAN IP (v73.89) — REQUIRED so the HTTPS cert covers the address
# your browser/devices actually connect to (e.g. https://192.168.1.7:8055).
# Find it with `hostname -I` or `ip addr` on the host machine. Without this
# set, browsers will load the dashboard page itself but silently fail every
# background fetch (Debug Log, live data refresh, etc.) with "Failed to
# fetch", because the container can't see the host's real LAN IP on its own.
HOST_IP=192.168.1.7
# Timezone
TZ=Pacific/Auckland
# Sync server port (default: 8055)
SYNC_PORT=8055
# Shared secret token — ALL field devices must use this exact token
# Enter it in the app: Backup & Sync → Configure → Sync Token
SYNC_TOKEN=qg5YAagV88rHWv1eatfzMdmfirX3tcZD
# How often to create automatic backups (minutes, min 5)
BACKUP_INTERVAL_MINUTES=60
# How many backups to keep before pruning oldest
MAX_BACKUPS=48
# How many days to retain tombstone records (deleted-item tracking)
TOMBSTONE_DAYS=90
# Max payload size for incoming sync data
SYNC_MAX_BODY_SIZE=10gb
# Road Data (Select Roads mode) auto-update from OpenStreetMap — v73.56
# Operating-area bbox, SAME format as extract-roads.sh's BBOX variable:
# min_longitude,min_latitude,max_longitude,max_latitude
# Leave blank to disable the dashboard's "Update Road Data (OSM)" button
# (extract-roads.sh + restore-road-data.sh remain available either way).
ROADS_BBOX=175.15,-37.85,175.35,-37.70
# Overpass API endpoint. The public default is free but rate-limited and can
# be slow/unavailable at peak times — change this if you self-host an
# Overpass instance or prefer a different public mirror.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# OSRM road-matching service (v73.69) — internal Docker network address,
# only change if OSRM runs somewhere other than this compose stack.
# Build the graph first with ./setup-osrm.sh before `docker compose up`.
OSRM_URL=http://osrm:5000
# Host port OSRM's HTTP API is published on, for manual testing (curl/browser).
OSRM_PORT=5000
