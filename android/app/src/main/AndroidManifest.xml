<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access - reaching the host sync server (host-server/) and OSRM for road routing. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- GPS - inspection/photo location tagging, sweep-job live tracking. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Camera - "Take Photo at GPS Location" etc. capture="environment" file inputs. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Storage - the system file/gallery picker (ACTION_GET_CONTENT) normally doesn't need
         these (the picker app itself handles storage access, not us), but some older/OEM
         Android builds still check the caller's own permission before letting the picker
         return a result. maxSdkVersion scopes these off on modern Android where they're both
         unnecessary and can't be granted anyway (superseded by scoped storage / the photo
         picker). Defensive - v73.131. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Keep the screen on during long live-tracking sessions (Wake Lock API called from JS). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.RswFieldApp"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider - supplies a content:// URI for the camera intent's output file
             (needed so the camera app can write the photo somewhere this app can read it back
             from, per Android's scoped-storage rules) inside onShowFileChooser's camera flow. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="nz.co.rsw.fieldapp.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
