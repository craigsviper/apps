# ─────────────────────────────────────────────────────────────────────────────
# RSW Field App v40.6 — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# App port (HTTPS). Change if 8050 conflicts with another service.
RSW_PORT=8050

# Timezone — used by Docker container for correct timestamps
# Examples: Pacific/Auckland, Australia/Sydney, America/Los_Angeles, Europe/London
TZ=Pacific/Auckland

# ─────────────────────────────────────────────────────────────────────────────
# Sync Server (OPTIONAL — for multi-device team sync)
# Leave blank if you only use a single device.
# ─────────────────────────────────────────────────────────────────────────────

# URL of your RSW Sync Server (e.g. http://192.168.1.100:8055)
# Set this inside the app under Backup & Sync → Sync Settings
# SYNC_SERVER_URL=

# Shared token — all team devices must use the same token
# SYNC_TOKEN=your-secret-token-here

# ─────────────────────────────────────────────────────────────────────────────
# Notes
# ─────────────────────────────────────────────────────────────────────────────
# • All app data is stored in the browser's IndexedDB (no server database needed)
# • Session survives browser refreshes — stored credentials in localStorage
# • The app runs on HTTPS port 8050 (HTTPS required for GPS & camera on mobile)
# • Default admin login:  admin@inspection.com  /  admin123
#   Change this immediately after first login in System → Users
